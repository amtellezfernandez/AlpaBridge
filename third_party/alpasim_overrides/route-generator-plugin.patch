 src/runtime/alpasim_runtime/config.py         | 12 +--
 src/runtime/alpasim_runtime/event_loop.py     |  1 -
 .../alpasim_runtime/route_generator.py        | 79 +++++++++++++------
 .../alpasim_runtime/runtime_context.py        | 14 ++++
 .../alpasim_runtime/unbound_rollout.py        |  5 +-
 src/runtime/tests/test_event_loop.py          |  1 -
 src/runtime/tests/test_route_generator.py     | 24 +++---
