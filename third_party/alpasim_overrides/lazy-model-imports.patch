From a91d23136888be7396acc3632174f5de4e6eeaa4 Mon Sep 17 00:00:00 2001
From: AlpaBridge maintainers <alpabridge@users.noreply.github.com>
Date: Wed, 12 Aug 2026 21:36:07 +0200
Subject: [PATCH] driver: lazily import optional model backends in
 models/__init__

models/__init__ eagerly imports every built-in backend, so `from alpasim_driver.models
import BaseTrajectoryModel` drags in VAM and all three Alpamayo models. In a minimal
external-driver environment -- where the policy runs on the host and the heavyweight
backends are deliberately not installed -- that import fails outright, even though the
caller only wanted the base abstractions.

Resolve the optional backends through a module __getattr__ instead. Every public name is
unchanged and still in __all__, so `from alpasim_driver.models import Alpamayo2Model`
behaves exactly as before when its dependencies are present; it just no longer costs an
import when they are not.

Note for reviewers: this file is one that must be kept in step as backends are added --
Alpamayo2Model landed in the August 2026 sync and is included here.
---
 .../src/alpasim_driver/models/__init__.py     | 34 ++++++++++++++++---
 1 file changed, 29 insertions(+), 5 deletions(-)

diff --git a/src/driver/src/alpasim_driver/models/__init__.py b/src/driver/src/alpasim_driver/models/__init__.py
index 62b5b3c..9f9cc2e 100644
--- a/src/driver/src/alpasim_driver/models/__init__.py
+++ b/src/driver/src/alpasim_driver/models/__init__.py
@@ -1,11 +1,19 @@
 # SPDX-License-Identifier: Apache-2.0
 # Copyright (c) 2025-2026 NVIDIA Corporation
 
-"""Model abstraction layer for trajectory prediction models."""
+"""Model abstraction layer for trajectory prediction models.
+
+This override keeps the base abstractions importable in minimal local-driver
+environments where heavyweight built-in backends (VAM/Alpamayo) are not
+installed. Those backends remain available through their entry points when
+their optional dependencies are present.
+"""
+
+from __future__ import annotations
+
+from importlib import import_module
+from typing import Any
 
-from .alpamayo1_5_model import Alpamayo15Model
-from .alpamayo1_model import Alpamayo1Model
-from .alpamayo2_model import Alpamayo2Model
 from .base import (
     BaseTrajectoryModel,
     CameraFrame,
@@ -15,7 +23,13 @@ from .base import (
     PredictionInput,
 )
 from .manual_model import ManualModel
-from .vam_model import VAMModel
+
+_LAZY_IMPORTS = {
+    "Alpamayo15Model": ".alpamayo1_5_model",
+    "Alpamayo1Model": ".alpamayo1_model",
+    "Alpamayo2Model": ".alpamayo2_model",
+    "VAMModel": ".vam_model",
+}
 
 __all__ = [
     "Alpamayo15Model",
@@ -30,3 +44,13 @@ __all__ = [
     "PredictionInput",
     "VAMModel",
 ]
+
+
+def __getattr__(name: str) -> Any:
+    module_name = _LAZY_IMPORTS.get(name)
+    if module_name is None:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+    module = import_module(module_name, __name__)
+    value = getattr(module, name)
+    globals()[name] = value
+    return value
