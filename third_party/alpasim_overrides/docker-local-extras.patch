From 771922e8ab302b2529a9c740ae0a242b327b3aa3 Mon Sep 17 00:00:00 2001
From: AlpaBridge maintainers <alpabridge@users.noreply.github.com>
Date: Wed, 12 Aug 2026 21:35:43 +0200
Subject: [PATCH] packaging: add a docker_local extras group for headless
 runtime images

`--extra all` pulls the full workspace into the runtime image, including packages a
headless simulation container never runs: alpasim-tools (PyQt5), alpasim_driver and
alpasim_plugins (whose learned-driver stack pulls x86-only wheels such as tensordict),
alpasim_wizard (launched on the host), and alpasim-trafficsim (torch_geometric, whose PyG
extensions the Dockerfile installs from an x86-pinned wheel index).

Name that subset so image builds can ask for it directly instead of each deployment
re-deriving it. No effect on existing `--extra all` builds.
---
 pyproject.toml | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/pyproject.toml b/pyproject.toml
index 3f5231a..52776e9 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -37,6 +37,19 @@ all = [
   "alpasim-trafficsim",
 ]
 
+# Core packages needed inside headless simulation Docker images.
+# Excludes alpasim-tools (PyQt5), alpasim_driver/alpasim_plugins (x86-only deps via the
+# learned-driver models; the driver can run on the host), alpasim_wizard (host-launched),
+# and alpasim-trafficsim (torch_geometric/PyG, x86-pinned in the Dockerfile).
+docker_local = [
+  "alpasim_controller",
+  "alpasim_eval",
+  "alpasim_grpc",
+  "alpasim-runtime",
+  "alpasim_utils",
+  "alpasim-physics",
+]
+
 # -- Model extras --
 recipes = ["alpasim_driver[recipes]"]
 
