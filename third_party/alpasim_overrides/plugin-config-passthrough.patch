From e4036960fad9cfd87ca611c7e9789d2b8bbb13e2 Mon Sep 17 00:00:00 2001
From: AlpaBridge maintainers <alpabridge@users.noreply.github.com>
Date: Wed, 12 Aug 2026 21:36:07 +0200
Subject: [PATCH] driver: add a free-form pass-through field for third-party
 model plugins

model_type resolves through the alpasim.models entry-point registry, so a third-party
backend can be added without touching driver code -- but its configuration cannot. ModelConfig
is a structured config, so OmegaConf rejects any key it does not declare, and a plugin has
nowhere to put its own options.

Add `model.extra`, a plain dict, so a plugin can take `model.extra.my_param` without
ModelConfig having to know about it. Built-in backends are unaffected.

Re-cut against main @ 1e801ca: the previous revision did not apply after ModelConfig
replaced use_classifier_free_guidance_nav with a weight-based field and expanded its
docstring.
---
 src/driver/src/alpasim_driver/schema.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/driver/src/alpasim_driver/schema.py b/src/driver/src/alpasim_driver/schema.py
index d39cc39..f066532 100644
--- a/src/driver/src/alpasim_driver/schema.py
+++ b/src/driver/src/alpasim_driver/schema.py
@@ -4,6 +4,7 @@
 """Configuration schema for driver service supporting multiple model backends."""
 
 from dataclasses import dataclass, field
+from typing import Any
 
 from omegaconf import MISSING
 
@@ -48,6 +49,11 @@ class ModelConfig:
     # instruction to blend towards.
     cfg_guidance_weight: float | None = None
     force_determinism: bool = False  # Alpamayo models only
+    # Free-form pass-through for third-party model plugins. OmegaConf's structured-config
+    # validation rejects unknown keys on this dataclass, so a plugin cannot accept its own
+    # options without ModelConfig knowing them in advance; a plain dict field can carry
+    # arbitrary nested keys, e.g. model.extra.my_param.
+    extra: dict[str, Any] = field(default_factory=dict)
     num_trajectory_samples: int = 1  # Alpamayo models only
     # Where camera JPEGs are decoded.  ``cuda`` leaves the frames on the
     # device, so the model's preprocessing resizes there too (Alpamayo models
